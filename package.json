{
  "name": "mcp.rendley.com",
  "version": "1.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/rendleyhq/rendley-mcp"
  },
  "description": "Create videos with prompts, and use Rendley’s video editor to adjust anything you need.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "dev": "LOG_PRETTY=true bun --preload ./src/instrumentation.ts --watch src/index.ts",
    "start": "bun --preload ./src/instrumentation.ts src/index.ts",
    "typecheck": "tsc --noEmit",
    "tunnel": "cloudflared tunnel --url http://localhost:8787 --hostname rendley-mcp",
    "postinstall": "test \"$PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD\" = \"1\" || playwright install chromium || echo 'Playwright chromium install failed — set USE_CHROME_CHANNEL=true and use system Chrome, or retry \"bunx playwright install chromium\".'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.220.0",
    "@opentelemetry/resources": "2.9.0",
    "@opentelemetry/sdk-logs": "0.220.0",
    "hono": "4.12.30",
    "p-queue": "9.3.1",
    "pino": "10.3.1",
    "playwright": "1.61.1",
    "posthog-node": "5.44.0",
    "xxhashjs": "0.2.2",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "26.1.1",
    "pino-pretty": "13.1.3",
    "typescript": "7.0.2"
  }
}
